{
  "name": "fetchcat-n8n-workflows",
  "version": "1.0.0",
  "private": true,
  "description": "Public, tested n8n workflow templates for FetchCat Apify Actors",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-workflows.mjs",
    "test:pinterest": "node scripts/test-pinterest-monitor.mjs",
    "test:tiktok": "node scripts/test-tiktok-workflows.mjs",
    "test:telegram": "node scripts/test-telegram-workflows.mjs",
    "test:demand": "node scripts/test-demand-workflows.mjs",
    "test:vinted": "node scripts/test-vinted-monitor.mjs",
    "validate": "node scripts/validate.mjs",
    "sanitize": "node scripts/sanitize.mjs",
    "import": "node scripts/n8n-cli.mjs import",
    "execute": "node scripts/n8n-cli.mjs execute",
    "export": "node scripts/n8n-cli.mjs export",
    "package": "node scripts/package.mjs",
    "check": "npm run build && git diff --exit-code && npm run validate && npm run test:pinterest && npm run test:tiktok && npm run test:telegram && npm run test:demand && npm run test:vinted && npm run test:youtube-breakouts && npm run test:creator-portal && npm run test:sheet-style",
    "test:youtube-breakouts": "node scripts/test-youtube-niche-breakout-finder.mjs",
    "test:creator-portal": "node scripts/test-creator-portal.mjs",
    "test:sheet-style": "node scripts/test-sheet-style.mjs"
  },
  "license": "MIT"
}
