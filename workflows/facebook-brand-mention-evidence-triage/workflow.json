        "jsCode": "const s = $input.first().json;\nif (!s.query?.trim() || s.query.length > 100 || !Number.isInteger(s.resultsCount) || s.resultsCount < 1 || s.resultsCount > 10 || !['top','latest'].includes(s.searchType) || !Number.isFinite(s.maxCostUsd) || s.maxCostUsd <= 0 || s.maxCostUsd > 0.15 || !Number.isInteger(s.maxRunSeconds) || s.maxRunSeconds < 10 || s.maxRunSeconds > 60 || s.model !== 'gpt-5.4-mini' || s.maxOutputTokens !== 800) throw new Error('Use a query up to 100 characters, 1–10 posts, top/latest, 10–60 seconds, max cost up to $0.15, gpt-5.4-mini and 800 output tokens.');\nif (!/^https:\\/\\/docs\\.google\\.com\\/spreadsheets\\/d\\/[A-Za-z0-9_-]+/.test(s.sheetUrl)) throw new Error('Setup: copy the sheet template, paste its URL into sheetUrl in node 1, and connect Apify, OpenAI and Google Sheets credentials.');\nreturn [{json:s}];"
