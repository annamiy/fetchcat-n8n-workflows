    {
      "id": "fb-4",
      "name": "2. Search public Facebook posts",
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 2,
      "position": [
        800,
        400
      ],
      "parameters": {
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "actorSource": "store",
        "actorId": {
          "__rl": true,
          "mode": "id",
          "value": "XfwikbuyOMuMnO1eJ"
        },
        "actorInputMode": "json",
        "customBody": "={{ JSON.stringify({ query: $json.query.trim(), resultsCount: $json.resultsCount, searchType: $json.searchType, maxRunSeconds: $json.maxRunSeconds }) }}",
        "maxTotalChargeUsd": "={{ $('1. Set your brand search').first().json.maxCostUsd }}",
