        "jsCode": "const rows=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]).slice(0,10); const serial=d=>new Date(d||Date.now()).getTime()/86400000+25569; return rows.filter(v=>v.sourceUrl||v.videoUrl).map(v=>{const url=String(v.videoUrl||v.sourceUrl); return {json:{itemKey:url,title:String(v.title||v.description||v.hashtag||'TikTok trend').slice(0,180),source:v.authorUsername?'@'+String(v.authorUsername).replace(/^@/,''):String(v.region||v.keywordOrUrl||''),metric:[v.viewCount?Number(v.viewCount).toLocaleString()+' views':'',v.likeCount?Number(v.likeCount).toLocaleString()+' likes':'',v.rank?('Rank '+v.rank):''].filter(Boolean).join(' | '),status:'New '+String(v.trendType||'trend')+' result',summary:JSON.stringify({description:v.description,hashtag:v.hashtag,sound:v.soundTitle,shares:v.shareCount,comments:v.commentCount}),url,observedAt:serial(v.scrapedAt)}};});"
