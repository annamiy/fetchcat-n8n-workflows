    {
      "parameters": {
        "jsCode": "\nfunction parseStructured(root, requiredKeys) {\n  const seen = new Set();\n  function visit(value) {\n    if (value === null || value === undefined) return null;\n    if (typeof value === 'string') {\n      const text = value.trim().replace(/^\\x60\\x60\\x60(?:json)?\\s*/i, '').replace(/\\s*\\x60\\x60\\x60$/, '');\n      if (!text.startsWith('{')) return null;\n      try { return visit(JSON.parse(text)); } catch { return null; }\n    }\n    if (typeof value !== 'object' || seen.has(value)) return null;\n    seen.add(value);\n    if (requiredKeys.every((key) => Object.prototype.hasOwnProperty.call(value, key))) return value;\n    for (const key of ['output_text', 'outputText', 'text', 'content', 'output', 'message', 'response', 'data']) {\n      if (Object.prototype.hasOwnProperty.call(value, key)) { const found = visit(value[key]); if (found) return found; }\n    }\n    for (const nested of Array.isArray(value) ? value : Object.values(value)) { const found = visit(nested); if (found) return found; }\n    return null;\n  }\n  return visit(root);\n}\nconst batch=$('Build One Bounded Batch').first().json; const parsed=parseStructured($input.first().json,['results']); if(!parsed||!Array.isArray(parsed.results)) throw new Error('OpenAI returned invalid structured output.'); const expected=new Set(batch.itemKeys); const actual=parsed.results.map(r=>String(r.itemKey)); if(actual.length!==expected.size||new Set(actual).size!==actual.length||actual.some(k=>!expected.has(k))) throw new Error('OpenAI result keys do not exactly match the input batch.'); const byKey=new Map(batch.items.map(i=>[i.itemKey,i])); const selected=[]; for(const r of parsed.results){if(typeof r.qualified!=='boolean'||!Number.isInteger(r.score)||r.score<0||r.score>100||!String(r.insight||'').trim()||!String(r.action||'').trim()) throw new Error('Malformed analysis result.'); if(r.qualified&&r.score>=batch.minimumScore) selected.push({...byKey.get(String(r.itemKey)),score:r.score,insight:String(r.insight).trim(),action:String(r.action).trim()});} return [{json:{allKeys:batch.itemKeys,selected}}];"
      },
      "id": "32000000-0000-0000-4000-8000-000000000012",
      "name": "Validate Structured Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const source=$input.first().json; const selected=[...source.selected].sort((a,b)=>b.score-a.score); if(!selected.length) return []; const serial=v=>v||Date.now()/86400000+25569; const safe=v=>{const s=String(v??''); return /^[=+\\-@]/.test(s)?\"'\"+s:s}; const rows=selected.map(i=>({ 'Observed at':serial(i.observedAt),'Item':safe(i.title),'Source':safe(i.source),'Metric':safe(i.metric),'Status':safe(i.status+(i.score!==undefined?' | Score '+i.score+'/100':'')),'Insight':safe(i.insight),'Recommended action':safe(i.action),'Link':i.url?'=HYPERLINK(\"'+String(i.url).replace(/\"/g,'\"\"')+'\",\"Open source\")':'','Item key':safe(i.itemKey) })); const lines=selected.slice(0,5).map((i,x)=>(x+1)+'. '+i.title+'\\n'+i.metric+' | '+i.status+'\\n'+i.insight+'\\n'+i.url); return [{json:{allKeys:source.allKeys,rows,notification:\"Find Viral TikTok Content Opportunities with Apify, OpenAI, Google Sheets and Telegram\"+'\\n\\n'+lines.join('\\n\\n')}}];"
      },
