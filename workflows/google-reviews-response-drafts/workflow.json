        "jsCode": "const rows=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]).slice(0,10); const serial=d=>new Date(d||Date.now()).getTime()/86400000+25569; return rows.filter(r=>r.reviewUrl||r.text).map(r=>({json:{itemKey:String(r.reviewUrl||[r.placeUrl,r.reviewerName,r.relativeDate,r.text].join('|')),title:String(r.placeTitle||'Google review'),source:String(r.reviewerName||'Anonymous'),metric:String(r.rating||'')+'/5',status:r.ownerResponse?'Already answered':'Needs review',summary:String(r.text||'').slice(0,3000),url:String(r.reviewUrl||r.placeUrl||''),observedAt:serial(r.scrapedAt)}}));"
