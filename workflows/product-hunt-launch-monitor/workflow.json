        "jsCode": "const rows=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]).slice(0,10); const serial=d=>new Date(d||Date.now()).getTime()/86400000+25569; return rows.filter(p=>p.productUrl&&p.title).map(p=>({json:{itemKey:String(p.productUrl),title:String(p.title),source:String((p.topics||p.categories||[]).join(', ')),metric:[p.votes?(p.votes+' votes'):'',p.comments?(p.comments+' comments'):''].filter(Boolean).join(' | '),status:'New launch',summary:String(p.tagline||'')+' | '+JSON.stringify({makers:p.makers,rank:p.rank,outboundUrl:p.outboundUrl}),url:String(p.productUrl),observedAt:serial(p.launchDate||p.scrapedAt)}}));"
