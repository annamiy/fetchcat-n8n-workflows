      "parameters": {
        "jsCode": "const c=$input.first().json; const locations=String(c.locations||'').split(';').map(v=>v.trim()).filter(Boolean); if(!locations.length) throw new Error('Add semicolon-separated Zillow locations or search URLs.'); const maxItems=Math.max(1,Math.min(Number(c.maxItems)||10,10)); return [{json:{maxItems,actorInput:{locations,listingType:String(c.listingType||'for_sale'),minBeds:Number(c.minBeds)||0,maxPrice:Number(c.maxPrice)||undefined,maxItems,maxPages:1,proxyConfiguration:{useApifyProxy:true}}}}];"
