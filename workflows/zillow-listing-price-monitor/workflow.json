    {
      "parameters": {
        "jsCode": "const items=$input.all().map(i=>i.json).slice(0,10); if(!items.length) return []; return [{json:{items,itemKeys:items.map(i=>i.itemKey),minimumScore:Number($('Validate Settings and Build Actor Input').first().json.minimumScore)||0,context:String($('Validate Settings and Build Actor Input').first().json.context||'')}}];"
      },
      "id": "37000000-0000-0000-4000-8000-000000000010",
      "name": "Build One Bounded Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const items=$input.first().json.items; if(!items.length) return []; const serial=v=>v||Date.now()/86400000+25569; const safe=v=>{const s=String(v??''); return /^[=+\\-@]/.test(s)?\"'\"+s:s}; const rows=items.map(i=>({ 'Observed at':serial(i.observedAt),'Item':safe(i.title),'Source':safe(i.source),'Metric':safe(i.metric),'Status':safe(i.status),'Insight':safe(i.summary),'Recommended action':'Review this new or changed result','Link':i.url?'=HYPERLINK(\"'+String(i.url).replace(/\"/g,'\"\"')+'\",\"Open source\")':'','Item key':safe(i.itemKey) })); const lines=items.slice(0,5).map((i,x)=>(x+1)+'. '+i.title+'\\n'+i.metric+' | '+i.status+'\\n'+i.summary+'\\n'+i.url); return [{json:{allKeys:$input.first().json.itemKeys,rows,notification:\"Monitor Zillow Listings and Price Drops with Apify, Google Sheets and Telegram\"+'\\n\\n'+lines.join('\\n\\n')}}];"
      },
