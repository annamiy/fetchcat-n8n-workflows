    {
      "parameters": {
        "jsCode": "const rows=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]).slice(0,10); const serial=d=>new Date(d||Date.now()).getTime()/86400000+25569; const readable=v=>String(v||'Active').toLowerCase().split('_').map(w=>w.charAt(0).toUpperCase()+w.slice(1)).join(' '); return rows.filter(p=>p.zpid&&p.url).map(p=>{const amount=Number(p.unformattedPrice); const priceText=String(p.price||(!Number.isNaN(amount)?new Intl.NumberFormat('en-US',{style:'currency',currency:String(p.currency||'USD'),maximumFractionDigits:0}).format(amount):'Price unavailable')); const status=readable(p.homeStatus||p.status); return {json:{itemKey:[p.zpid,Number.isNaN(amount)?priceText:amount,status,p.openHouse].join('|'),title:String(p.address||p.zpid),source:String(p.listingType||''),metric:priceText,status,summary:[p.beds?(p.beds+' beds'):'',p.baths?(p.baths+' baths'):'',p.area?(p.area+' sq ft'):'',p.openHouse?('Open house '+p.openHouse):''].filter(Boolean).join(' | '),url:String(p.url),observedAt:serial(p.scrapedAt)}};});"
      },
