        "method": "POST",
        "url": "https://api.apify.com/v2/acts/B5qu4d1iteAp2TaF1/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept-Encoding",
              "value": "identity"
            }
