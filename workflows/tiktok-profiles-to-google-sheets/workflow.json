    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "tiktok-profiles",
              "name": "profiles",
              "value": "tiktok\napify",
              "type": "string"
            },
            {
