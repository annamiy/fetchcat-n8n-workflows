      "parameters": {
        "jsCode": "const places=$('Download Actor Results').all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]); const domains=[...new Set(places.map(p=>String(p.website||'').trim()).filter(Boolean))].slice(0,10); return [{json:{actorInput:{domains,maxPagesPerDomain:5,crawlDepth:1,includeSitemap:false,sameDomainOnly:true,includePhones:true,includeSocialLinks:true,validateMx:false,proxyConfiguration:{useApifyProxy:false}}}}];"
