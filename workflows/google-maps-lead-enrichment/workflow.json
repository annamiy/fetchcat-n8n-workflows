    {
      "parameters": {
        "jsCode": "const rows=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]); const places=$('Download Actor Results').all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]).slice(0,10); const serial=d=>new Date(d||Date.now()).getTime()/86400000+25569; const host=v=>{try{return new URL(String(v).startsWith('http')?v:'https://'+v).hostname.replace(/^www./,'')}catch{return String(v||'').replace(/^www./,'')}}; const contacts=new Map(rows.filter(r=>r.domain).map(r=>[host(r.domain),r])); return places.filter(p=>p.googleMapsUrl&&p.title).map(p=>{const c=contacts.get(host(p.website))||{}; const emails=Array.isArray(c.emails)?c.emails.join(', '):String(c.email||''); const phones=Array.isArray(c.phones)?c.phones.join(', '):String(c.phone||p.phone||''); return {json:{itemKey:String(p.googleMapsUrl),title:String(p.title),source:String(p.category||p.address||''),metric:[p.rating?('Rating '+p.rating):'',p.reviewCount?('Reviews '+p.reviewCount):''].filter(Boolean).join(' | '),status:emails?'Public email found':(p.website?'Website found':'No website'),summary:[emails,phones,p.website].filter(Boolean).join(' | '),url:String(p.googleMapsUrl),observedAt:serial(p.scrapedAt)}};});"
      },
