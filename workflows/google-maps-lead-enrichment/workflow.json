    {
      "parameters": {
        "jsCode": "const items=$input.first().json.items; if(!items.length) return []; const serial=v=>v||Date.now()/86400000+25569; const safe=v=>{const s=String(v??''); return /^[=+\\-@]/.test(s)?\"'\"+s:s}; const rows=items.map(i=>({ 'Observed at':serial(i.observedAt),'Item':safe(i.title),'Source':safe(i.source),'Metric':safe(i.metric),'Status':safe(i.status),'Insight':safe(i.summary),'Recommended action':'Review this new or changed result','Link':i.url?'=HYPERLINK(\"'+String(i.url).replace(/\"/g,'\"\"')+'\",\"Open source\")':'','Item key':safe(i.itemKey) })); const lines=items.slice(0,5).map((i,x)=>(x+1)+'. '+i.title+'\\n'+i.metric+' | '+i.status+'\\n'+i.summary+'\\n'+i.url); return [{json:{allKeys:$input.first().json.itemKeys,rows,notification:\"Generate and Enrich Google Maps Leads with Apify, Google Sheets and Slack\"+'\\n\\n'+lines.join('\\n\\n')}}];"
      },
