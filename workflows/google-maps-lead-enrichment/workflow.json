        "jsCode": "const items=$input.all().map(i=>i.json).slice(0,10); if(!items.length) return []; return [{json:{items,itemKeys:items.map(i=>i.itemKey),minimumScore:Number($('Validate Settings and Build Actor Input').first().json.minimumScore)||0,context:String($('Validate Settings and Build Actor Input').first().json.context||'')}}];"
      },
      "id": "31000000-0000-0000-4000-8000-000000000010",
      "name": "Build One Bounded Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
