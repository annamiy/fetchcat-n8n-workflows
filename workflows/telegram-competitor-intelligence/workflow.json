    {
      "parameters": {
        "jsCode": "const input = $('Telegram Setup Form').first().json;\nconst channels = String(input.channels || '').split(/[\\n,]/).map((value) => value.trim()).filter(Boolean);\nconst productContext = String(input.productContext || '').trim();\nconst minimumScore = Number(input.minimumScore);\nconst maxItems = Number(input.maxItems);\nconst slackChannelId = String(input.slackChannelId || '').trim();\nif (channels.length < 1 || channels.length > 10) throw new Error('Enter 1 to 10 public Telegram channel usernames or t.me URLs.');\nif (productContext.length < 20 || productContext.length > 4000) throw new Error('Product context must be 20 to 4000 characters.');\nif (!Number.isFinite(minimumScore) || minimumScore < 0 || minimumScore > 100) throw new Error('Minimum score must be between 0 and 100.');\nif (!Number.isFinite(maxItems) || maxItems < 1 || maxItems > 10) throw new Error('Max items must be between 1 and 10.');\nreturn [{ json: { configKey: 'default', channels: channels.join(','), productContext, minimumScore, maxItems, slackChannelId } }];"
