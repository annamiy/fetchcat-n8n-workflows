      "id": "30000000-0000-0000-4000-8000-000000000005",
      "name": "Fetch Telegram Posts",
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 1,
      "position": [
        160,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const normalized = [];\nfor (const item of $input.all()) {\n  const post = item.json;\n  const postId = post.id || post.postId || post.messageId || post.url;\n  const text = String(post.text || post.message || post.caption || '').trim();\n  if (!postId || text.length < 20) continue;\n  const channel = String(post.channelUsername || post.channelTitle || post.channelId || '').replace(/^@/, '');\n  normalized.push({ json: {\n    telegramId: String(postId),\n    itemKey: 'telegram-competitor-intelligence:' + String(postId),\n    channel,\n    title: text.split(/\\n/)[0].slice(0, 140),\n    text: text.slice(0, 8000),\n    url: String(post.url || post.postUrl || ''),\n    createdAt: String(post.date || post.createdAt || post.timestamp || ''),\n    views: Number(post.views || 0),\n    reactions: Number(post.reactions || post.reactionsCount || 0),\n    replies: Number(post.replies || post.repliesCount || post.commentsCount || 0),\n    links: Array.isArray(post.links) ? post.links.slice(0, 5) : [],\n    hashtags: Array.isArray(post.hashtags) ? post.hashtags.slice(0, 10) : []\n  } });\n  if (normalized.length === 10) break;\n}\nreturn normalized;"
      },
