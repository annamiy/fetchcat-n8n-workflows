    {
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-5.4-mini"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "user",
              "content": "=Product/market context:\n{{ $(\"Build Actor Input\").first().json.config.productContext }}\n\nMinimum signal score: {{ $(\"Build Actor Input\").first().json.config.minimumScore }}\n\nAnalyze these public Telegram posts exactly once and preserve each telegramId. Cite only supplied urls:\n{{ JSON.stringify($json.posts) }}"
            }
          ]
        },
        "simplify": true,
        "builtInTools": {},
        "options": {
          "instructions": "Identify competitor launches, promotions, positioning shifts, recurring topics, and unusually strong Telegram posts. Return exactly one result for every supplied telegramId and no others. Qualified means material competitive intelligence with score at or above the supplied minimum. Every qualified result must be evidence-bound to the supplied post URL.",
          "maxTokens": 4000,
          "reasoning": {
            "reasoningOptions": {
              "effort": "low",
              "summary": "none"
            }
          },
          "store": false,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "verbosity": "low",
              "name": "telegram_competitor_intelligence_batch",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"results\"],\"properties\":{\"results\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":10,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"telegramId\",\"qualified\",\"signalType\",\"score\",\"reason\",\"summary\",\"evidenceUrl\"],\"properties\":{\"telegramId\":{\"type\":\"string\",\"minLength\":1},\"qualified\":{\"type\":\"boolean\"},\"signalType\":{\"type\":\"string\",\"enum\":[\"launch\",\"promotion\",\"positioning\",\"topic_shift\",\"high_engagement\",\"other\",\"none\"]},\"score\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":500},\"summary\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":500},\"evidenceUrl\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1000}}}}}}",
              "description": "Identify competitor launches, promotions, positioning shifts, recurring topics, and unusually strong Telegram posts. Return exactly one result for every supplied telegramId and no others. Qualified means material competitive intelligence with score at or above the supplied minimum. Every qualified result must be evidence-bound to the supplied post URL.",
              "strict": true
            }
          }
        }
      },
      "id": "30000000-0000-0000-4000-8000-000000000009",
      "name": "Classify Telegram Batch",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function parseStructured(root, requiredKeys) {\n  const seen = new Set();\n  function visit(value) {\n    if (value === null || value === undefined) return null;\n    if (typeof value === 'string') {\n      const text = value.trim().replace(/^```(?:json)?s*/i, '').replace(/s*```$/, '');\n      if (!text.startsWith('{')) return null;\n      try { return visit(JSON.parse(text)); } catch { return null; }\n    }\n    if (typeof value !== 'object' || seen.has(value)) return null;\n    seen.add(value);\n    if (requiredKeys.every((key) => Object.prototype.hasOwnProperty.call(value, key))) return value;\n    for (const nested of Array.isArray(value) ? value : Object.values(value)) {\n      const found = visit(nested);\n      if (found) return found;\n    }\n    return null;\n  }\n  return visit(root);\n}\nconst batch = $('Build Telegram Batch').first().json;\nconst parsed = parseStructured($input.first().json, ['results']);\nif (!parsed || !Array.isArray(parsed.results)) throw new Error('OpenAI returned an invalid Telegram intelligence batch.');\nconst expectedIds = new Set(batch.telegramIds);\nconst actualIds = parsed.results.map((result) => String(result.telegramId));\nif (actualIds.length !== expectedIds.size || new Set(actualIds).size !== actualIds.length || actualIds.some((value) => !expectedIds.has(value))) throw new Error('OpenAI result IDs do not exactly match the Telegram input batch.');\nconst minimumScore = Number($('Build Actor Input').first().json.config.minimumScore);\nconst signalTypes = new Set(['launch','promotion','positioning','topic_shift','high_engagement','other','none']);\nconst byId = new Map(batch.posts.map((post) => [post.telegramId, post]));\nconst qualifiedPosts = [];\nfor (const result of parsed.results) {\n  if (typeof result.qualified !== 'boolean' || !signalTypes.has(result.signalType) || !Number.isInteger(result.score) || result.score < 0 || result.score > 100 || typeof result.reason !== 'string' || !result.reason.trim() || typeof result.summary !== 'string' || !result.summary.trim() || typeof result.evidenceUrl !== 'string') throw new Error('OpenAI returned a malformed Telegram result.');\n  const post = byId.get(String(result.telegramId));\n  if (result.qualified && result.evidenceUrl !== post.url) throw new Error('OpenAI cited evidence outside the supplied Telegram post URL.');\n  if (!result.qualified || result.signalType === 'none' || result.score < minimumScore) continue;\n  qualifiedPosts.push({ ...post, intent: result.signalType, intentScore: result.score, reason: result.reason.trim(), summary: result.summary.trim() });\n}\nreturn [{ json: { allKeys: batch.posts.map((post) => post.itemKey), qualifiedPosts } }];"
      },
      "id": "30000000-0000-0000-4000-8000-000000000010",
      "name": "Validate Telegram Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "00000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.qualifiedPosts.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "30000000-0000-0000-4000-8000-000000000011",
      "name": "Has Qualified Posts",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const posts = $json.qualifiedPosts.sort((a, b) => b.intentScore - a.intentScore).slice(0, 5);\nif (posts.length === 0) return [];\nconst lines = posts.map((post, index) => {\n  const engagement = Number(post.views || 0) + ' views | ' + Number(post.reactions || 0) + ' reactions | ' + Number(post.replies || 0) + ' replies';\n  const created = post.createdAt ? ' | ' + post.createdAt : '';\n  return (index + 1) + '. *' + post.title + '* [' + post.intent + ', ' + post.intentScore + '/100]\\n' + (post.channel || 'Telegram') + ' | ' + engagement + created + '\\n' + post.summary + '\\nWhy it matters: ' + post.reason + '\\nEvidence: ' + post.url;\n});\nreturn [{ json: { digestText: '*Telegram Competitor Intelligence Digest*\\n\\n' + lines.join('\\n\\n'), slackChannelId: $(\"Build Actor Input\").first().json.config.slackChannelId } }];"
      },
