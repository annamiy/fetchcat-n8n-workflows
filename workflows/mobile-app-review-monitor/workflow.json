      "id": "39000000-0000-0000-4000-8000-000000000011",
      "name": "3. Analyze Results in One Batch",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1360,
        80
      ]
