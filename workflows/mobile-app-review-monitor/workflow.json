            "textOptions": {
              "type": "json_schema",
              "verbosity": "low",
              "name": "fetchcat_demand_batch",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"results\"],\"properties\":{\"results\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":10,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"itemKey\",\"qualified\",\"score\",\"insight\",\"action\"],\"properties\":{\"itemKey\":{\"type\":\"string\",\"minLength\":1},\"qualified\":{\"type\":\"boolean\"},\"score\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100},\"insight\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":700},\"action\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":500}}}}}}",
