    {
      "parameters": {
        "jsCode": "const apple=$('Download Actor Results').all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]); const google=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]); const rows=[]; for(let i=0;rows.length<10&&(i<apple.length||i<google.length);i++){if(apple[i]) rows.push(apple[i]); if(rows.length<10&&google[i]) rows.push(google[i]);} const serial=d=>new Date(d||Date.now()).getTime()/86400000+25569; return rows.filter(r=>r.reviewId||r.content||r.reviewText).map(r=>({json:{itemKey:String(r.reviewId||[r.appId,r.authorName||r.reviewerName,r.updatedAt||r.reviewDate].join('|')),title:String(r.appName||'App review'),source:String(r.authorName||r.reviewerName||'Anonymous'),metric:String(r.rating||'')+'/5',status:(r.developerResponse||r.developerReply||r.developerReplyText)?'Already answered':'Needs review',summary:String(r.content||r.reviewText||'').slice(0,3000),url:String(r.reviewUrl||r.appUrl||''),observedAt:serial(r.updatedAt||r.reviewDate)}}));"
      },
