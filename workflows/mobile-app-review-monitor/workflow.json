              "content": "=Context: {{ $json.context }}\nMinimum score: {{ $json.minimumScore }}\nAnalyze every supplied item exactly once and preserve itemKey:\n{{ JSON.stringify($json.items) }}"
            }
          ]
        },
        "simplify": true,
        "builtInTools": {},
        "options": {
          "instructions": "Classify sentiment, bugs, feature requests, and urgency. Draft a factual response for human approval; never claim it was posted.",
          "maxTokens": 5000,
          "reasoning": {
            "reasoningOptions": {
