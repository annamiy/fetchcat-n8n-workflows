    {
      "id": "14869000-0000-4000-8000-000000000010",
      "name": "Check bounded research settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        500
      ],
      "parameters": {
        "jsCode": "const s=$input.first().json;\nif (!Number.isInteger(s.maxItems)||s.maxItems<1||s.maxItems>10||!(s.maxCostUsd>0&&s.maxCostUsd<=0.05)) throw new Error('Use 1–10 groups and an Apify cap above zero and at most $0.05.');\nif(!s.sheetId || !/^[a-zA-Z0-9_-]{20,}$/.test(s.sheetId)) throw new Error('Setup needed: copy the linked sheet, set sheetId in node 1, and connect Apify, OpenAI and Google Sheets credentials.');\nif(s.model!=='gpt-5.4-mini') throw new Error('This budgeted workflow supports gpt-5.4-mini only.');\nfor (const k of ['keywords','locations','researchBrief']) if(typeof s[k]!=='string'||!s[k].trim()||s[k].length>500) throw new Error('Provide short non-empty research settings (500 characters maximum each).');\nreturn [{json:s}];"
      }
    },
    {
      "id": "14869000-0000-4000-8000-000000000011",
      "name": "2. Discover indexed Facebook groups",
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 2,
      "position": [
        1080,
        500
      ],
      "parameters": {
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "actorSource": "store",
        "actorId": {
          "__rl": true,
          "mode": "id",
          "value": "lSTf18x2N28zwnbJY"
        },
        "actorInputMode": "json",
        "customBody": "={{ JSON.stringify({keywords:[$json.keywords],locations:[$json.locations],mode:\"scrape\",maxGroupsPerQuery:$json.maxItems,maxItems:$json.maxItems,privacy:\"any\",requireKeywordMatch:false,enrichIndexedDetails:false,enrichGroupDetails:false,enrichPaidGroupDetails:false}) }}",
        "maxTotalChargeUsd": "={{ $json.maxCostUsd }}",
        "authentication": "apifyApi"
      },
      "alwaysOutputData": true
    },
    {
      "id": "14869000-0000-4000-8000-000000000012",
      "name": "Canonicalize groups and retain provenance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        500
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json); const map=new Map();let invalid=0;\nconst text=(v,n=600)=>typeof v==='string'?v.slice(0,n):'';\nfor(const r of rows){ if(!r.groupUrl){if(Object.keys(r).length)invalid++;continue;} let url;\ntry {const m=String(r.groupUrl).match(/^https?:\\/\\/(?:(?:www|m|web)\\.)?facebook\\.com\\/groups\\/([a-zA-Z0-9._-]+)(?:[\\/?#]|$)/i);if(!m||['.','..','feed','discover','joins','create'].includes(m[1].toLowerCase()))throw 0;url='https://www.facebook.com/groups/'+m[1].toLowerCase()+'/';}catch{invalid++;continue;}\nif(map.has(url)){const g=map.get(url); const q=text(r.query,150);if(q&&!g.queries.includes(q))g.queries.push(q);continue;}\nif(map.size>=10)continue;\nmap.set(url,{url,name:text(r.groupName,120),queries:[text(r.query,150)],rank:Number.isFinite(r.rank)?r.rank:null,title:text(r.sourceTitle,160),snippet:text(r.sourceSnippet,600),collectedAt:text(r.collectedAt,60),privacy:['public','private'].includes(String(r.privacyLabel).toLowerCase())?String(r.privacyLabel).toLowerCase():'unknown',members:Number.isFinite(r.memberCount)&&r.memberCount>=0?r.memberCount:null,approximate:typeof r.memberCountIsApproximate==='boolean'?r.memberCountIsApproximate:null});}\nconst groups=[...map.values()];\nreturn [{json:{groups,invalid,status:groups.length?'ready':invalid?'partial-or-invalid':'empty',message:groups.length?(invalid?'Partial output: invalid rows omitted; review coverage.':'Indexed evidence only; location, activity and access unverified.'):'No usable groups returned. No AI call or sheet writes. Previous sheet contents remain unchanged.'}}];"
      }
    },
