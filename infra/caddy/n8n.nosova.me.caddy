n8n.nosova.me {
	encode zstd gzip

	# Editor, UI and internal REST need the same basic-auth login as the dashboard.
	# Webhooks, forms, health and the API-key-protected public API stay reachable.
	# Processes on the VPS itself (agents QA-ing in agent-browser) skip the login.
	@editor {
		not path /webhook/* /webhook-test/* /webhook-waiting/* /form/* /form-test/* /form-waiting/* /healthz /healthz/* /api/v1/*
		not remote_ip 46.224.160.65/32 127.0.0.1/32 ::1/128
	}
	basicauth @editor {
		anna $2a$14$REPLACE_WITH_caddy_hash-password_OUTPUT
	}

	reverse_proxy 127.0.0.1:5678 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
